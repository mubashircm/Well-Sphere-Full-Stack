# ==========================================
# HEALTH PLATFORM
# ROOT ENVIRONMENT TEMPLATE
# ==========================================

# Environment
NODE_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:5173

# Backend
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/health_platform

# Security (JWT)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

# Media Storage: Cloudinary (MongoDB stores metadata only)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional email (required for password resets and privileged-device OTP)
SMTP_URL=smtps://username:password@smtp.example.com:465
MAIL_FROM=Health Platform <no-reply@example.com>
