# ==========================================
# HEALTH PLATFORM — PRODUCTION BACKEND
# Zero-Cost Tier (Render / Railway + MongoDB Atlas)
# ==========================================

NODE_ENV=production
PORT=5000

# Client Application URL (CORS allowed origin)
CLIENT_URL=https://health-platform.vercel.app

# Database: MongoDB Atlas (M0 Free Tier 512MB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/health_platform?retryWrites=true&w=majority&appName=HealthPlatform

# Security: Strong 64+ Character Cryptographic Keys
JWT_ACCESS_SECRET=generate_strong_64_char_secret_for_production
JWT_REFRESH_SECRET=generate_another_strong_64_char_secret_for_production

# Cloudinary Media Storage (MongoDB stores secure URL & public_id only)
CLOUDINARY_CLOUD_NAME=your_production_cloud_name
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret

# Transactional Email (Resend / Brevo / SendGrid Free Tier)
SMTP_URL=smtps://apikey:re_your_api_key@smtp.resend.com:465
MAIL_FROM=Health Platform <security@yourdomain.com>
